{
  "manifestVersion": "engine.v5",
  "engineId": "engine.lhxhl.spray",
  "publisher": "lhxhl",
  "execution": {
    "engineApiMajor": 2,
    "supportedTargetTypes": [
      "domain",
      "ip",
      "cidr"
    ],
    "configSections": [
      {
        "id": "spray",
        "defaultEnabled": true,
        "params": [
          {
            "key": "wordlist",
            "type": "string",
            "default": "dir_default.txt",
            "resource": {
              "kind": "wordlist"
            }
          },
          {
            "key": "pool",
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 50
          },
          {
            "key": "threads",
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 100
          },
          {
            "key": "request-timeout",
            "type": "integer",
            "default": 5,
            "minimum": 1,
            "maximum": 120
          },
          {
            "key": "mod",
            "type": "string",
            "default": "path",
            "enum": [
              "path",
              "host"
            ]
          }
        ]
      }
    ]
  }
}
